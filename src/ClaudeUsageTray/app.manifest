<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ClaudeUsageTray.app" />

  <!--
    DPI 認識（PerMonitorV2）はここでは宣言しない。
    csproj の <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode> に一本化してある。
    両方に書くと WinForms アナライザが WFO0003 で「設定源が 2 つある」と警告する。
    これが効いていないと高 DPI で OS がアイコンをさらに拡大し、数字がボケる。
  -->

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
